//Ktra N có phải số ngto hay ko (Btap chương 1)
#include <stdio.h>
#include <math.h>

int main() {
    int N;
    scanf("%d", &N);

    if (N < 2) {
        printf("Khong phai so nguyen to");
    } else {
        int i;
        for (i = 2; i <= sqrt(N); i++) {
            if (N % i == 0) {
                printf("Khong phai so nguyen to");
                return 0;
            }
        }
        printf("La so nguyen to");
    }

    return 0;
}

